# Copy this file to docker/.env before changing deployment values.

POSTGRES_USER=agenthub
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=agenthub

REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-at-least-32-random-characters
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Optional, first deployment only. Remove after the administrator is created.
# AGENTHUB_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# AGENTHUB_BOOTSTRAP_ADMIN_USERNAME=admin
# AGENTHUB_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Host port exposed by nginx.
WEB_PORT=80
PUBLIC_BASE_URL=http://localhost
