{
  "name": "agenthub-tauri-client",
  "version": "0.1.0",
  "private": true,
  "description": "AgentHub local desktop application powered by Tauri 2 and a bundled FastAPI sidecar.",
  "scripts": {
    "tauri": "tauri",
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "check": "powershell -ExecutionPolicy Bypass -File scripts/check.ps1",
    "build:frontend": "pnpm --dir ../frontend build --mode desktop",
    "build:sidecar": "powershell -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "smoke:sidecar": "powershell -ExecutionPolicy Bypass -File scripts/smoke-sidecar.ps1",
    "smoke:app": "powershell -ExecutionPolicy Bypass -File scripts/smoke-app.ps1",
    "build:win": "powershell -ExecutionPolicy Bypass -File scripts/build-win.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  }
}
