{
    "folders": [
        {
            "path": "backend",
            "name": "Backend"
        },
        {
            "path": "frontend",
            "name": "Frontend"
        },
        {
            "path": "desktop-client",
            "name": "Tauri Desktop"
        },
        {
            "path": "e2e",
            "name": "E2E Tests"
        },
        {
            "path": "docker",
            "name": "Docker"
        },
        {
            "path": ".",
            "name": "Root"
        }
    ],
    "settings": {
        "files.exclude": {
            "**/__pycache__": true,
            "**/.venv": true,
            "**/node_modules": true,
            "**/.pytest_cache": true,
            "**/.ruff_cache": true,
            "**/*.egg-info": true,
            "**/.pnpm-store": true,
            "**/.build-sidecar": true,
            "**/target": true
        },
        "rust-analyzer.linkedProjects": [
            "${workspaceFolder:Tauri Desktop}/src-tauri/Cargo.toml"
        ]
    },
    "extensions": {
        "recommendations": [
            "tauri-apps.tauri-vscode",
            "rust-lang.rust-analyzer",
            "ms-python.python",
            "dbaeumer.vscode-eslint"
        ]
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Debug Backend",
                "type": "debugpy",
                "request": "launch",
                "program": "${workspaceFolder:Backend}/server.py",
                "cwd": "${workspaceFolder:Backend}",
                "jinja": true,
                "justMyCode": false
            }
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Tauri: Dev",
                "type": "shell",
                "command": "pnpm dev",
                "options": {
                    "cwd": "${workspaceFolder:Tauri Desktop}"
                },
                "problemMatcher": [],
                "isBackground": true,
                "presentation": {
                    "panel": "dedicated",
                    "group": "tauri"
                }
            },
            {
                "label": "Tauri: Build Sidecar",
                "type": "shell",
                "command": "pnpm build:sidecar",
                "options": {
                    "cwd": "${workspaceFolder:Tauri Desktop}"
                },
                "problemMatcher": [],
                "group": "build"
            },
            {
                "label": "Tauri: Check Rust",
                "type": "shell",
                "command": "pnpm check",
                "options": {
                    "cwd": "${workspaceFolder:Tauri Desktop}"
                },
                "problemMatcher": ["$rustc"],
                "group": "test"
            },
            {
                "label": "Tauri: Desktop Tests",
                "type": "shell",
                "command": ".\\scripts\\run-tests.ps1 -Stack backend -Module desktop -Type unit",
                "options": {
                    "cwd": "${workspaceFolder:Root}"
                },
                "problemMatcher": [],
                "group": "test"
            },
            {
                "label": "Tauri: Build Windows Installer",
                "type": "shell",
                "command": "pnpm build:win",
                "options": {
                    "cwd": "${workspaceFolder:Tauri Desktop}"
                },
                "problemMatcher": [],
                "group": "build",
                "presentation": {
                    "panel": "dedicated",
                    "group": "build"
                }
            },
            {
                "label": "Start Backend",
                "type": "shell",
                "command": "uv run server.py",
                "options": {
                    "cwd": "${workspaceFolder:Backend}"
                },
                "problemMatcher": [],
                "isBackground": true,
                "presentation": {
                    "panel": "dedicated",
                    "group": "servers"
                }
            },
            {
                "label": "Start Frontend",
                "type": "shell",
                "command": "pnpm dev",
                "options": {
                    "cwd": "${workspaceFolder:Frontend}"
                },
                "problemMatcher": [],
                "isBackground": true,
                "presentation": {
                    "panel": "dedicated",
                    "group": "servers"
                }
            },
            {
                "label": "Start All",
                "dependsOn": [
                    "Start Backend",
                    "Start Frontend"
                ],
                "dependsOrder": "parallel",
                "problemMatcher": []
            },
            {
                "label": "Backend Tests",
                "type": "shell",
                "command": "uv run pytest tests -q",
                "options": {
                    "cwd": "${workspaceFolder:Root}"
                },
                "problemMatcher": [],
                "group": {
                    "kind": "test",
                    "isDefault": true
                }
            },
            {
                "label": "Setup .env from example",
                "type": "shell",
                "command": "if (-not (Test-Path .env)) { Copy-Item .env.example .env; Write-Host '已复制 .env.example 到 .env，请按需修改配置。' } else { Write-Host '.env 已存在，跳过复制。' }",
                "options": {
                    "cwd": "${workspaceFolder:Root}"
                },
                "problemMatcher": [],
                "presentation": {
                    "panel": "dedicated",
                    "group": "setup"
                }
            },
            {
                "label": "Setup Backend",
                "type": "shell",
                "command": "uv sync --extra dev",
                "options": {
                    "cwd": "${workspaceFolder:Backend}"
                },
                "problemMatcher": [],
                "presentation": {
                    "panel": "dedicated",
                    "group": "setup"
                }
            },
            {
                "label": "Setup Frontend",
                "type": "shell",
                "command": "pnpm install",
                "options": {
                    "cwd": "${workspaceFolder:Frontend}"
                },
                "problemMatcher": [],
                "presentation": {
                    "panel": "dedicated",
                    "group": "setup"
                }
            },
            {
                "label": "Run Migrations",
                "type": "shell",
                "command": "uv run alembic upgrade head",
                "options": {
                    "cwd": "${workspaceFolder:Backend}"
                },
                "problemMatcher": [],
                "presentation": {
                    "panel": "dedicated",
                    "group": "setup"
                }
            },
            {
                "label": "Setup All",
                "dependsOn": [
                    "Setup .env from example",
                    "Setup Backend",
                    "Run Migrations",
                    "Setup Frontend"
                ],
                "dependsOrder": "sequence",
                "problemMatcher": [],
                "presentation": {
                    "panel": "dedicated",
                    "group": "setup"
                }
            }
        ]
    }
}
